# Contoh variabel lingkungan — salin ke .env lokal atau isi di Railway Variables.
# JANGAN menaruh token asli di file ini.

# Token akun Discord pribadi (wajib; tanpa ini bot berhenti diam-diam)
DISCORD_USER_TOKEN=contoh_token_palsu_jangan_pakai_asli

# ID channel pemantau: satu-satunya tempat perintah ! direspons (0 = semua channel milik sendiri)
MONITOR_CHANNEL_ID=123456789012345678

# Zona waktu patokan jadwal (contoh: Asia/Jakarta, Asia/Makassar)
TIMEZONE=Asia/Jakarta
